# ---------------------------------------------------------------------------
# Knowledge Garden backend configuration
# Copy to `.env` (or export in your shell) and adjust paths.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Absolute path to your Obsidian vault.
GARDEN_VAULT_PATH=C:\Projects\knowledge garden\Obsidian

# The *source* vault the one-way mirror reads from (your native vault).
# `python manage.py runmirror` watches this and copies changes into
# GARDEN_VAULT_PATH, then reindexes. The web app never reads this path directly.
GARDEN_SOURCE_VAULT=C:\Users\rayan\OneDrive\Documents\Obsidian

# Where the built index cache is written.
GARDEN_INDEX_PATH=C:\Projects\knowledge garden\backend\garden-index.json

# Base URL used when rewriting image embeds.
GARDEN_ATTACHMENT_URL=/api/attachments/

# Front-end origin(s) allowed by CORS (Vite dev server by default).
GARDEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret for the /api/sync/webhook/ endpoint. Leave blank for open
# access during development; set it in production.
GARDEN_WEBHOOK_SECRET=

# Optional: Meilisearch (falls back to in-memory search when unset).
MEILISEARCH_URL=
MEILISEARCH_KEY=
MEILISEARCH_INDEX=garden

# Optional: raise the GitHub API rate limit for live project metadata.
GITHUB_TOKEN=
